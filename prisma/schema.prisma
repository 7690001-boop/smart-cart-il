generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id      String         @id @default(cuid())
  email   String         @unique
  name    String
  lists   ShoppingList[]
  preferences UserPreferenceProfile?
}

model Store {
  id    String     @id @default(cuid())
  name  String
  skus  StoreSku[]
}

model CanonicalProduct {
  id                String     @id @default(cuid())
  name              String
  category          String
  brand             String?
  kosherAuthorities String[]
  premium           Boolean
  defaultSizeGram   Int
  skus              StoreSku[]
}

model StoreSku {
  id                 String           @id @default(cuid())
  storeId            String
  canonicalProductId String
  skuName            String
  brand              String?
  sizeGram           Int
  kosherAuthorities  String[]
  premium            Boolean
  priceAgorot        Int
  updatedAt          DateTime
  store              Store            @relation(fields: [storeId], references: [id])
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
}

model ShoppingList {
  id      String             @id @default(cuid())
  userId  String
  name    String
  user    User               @relation(fields: [userId], references: [id])
  items   ShoppingListItem[]
}

model ShoppingListItem {
  id                String       @id @default(cuid())
  listId            String
  canonicalProductId String
  quantity          Int
  brand             String
  kosherRequired    Boolean
  kosherAuthorities String[]
  premiumOnly       Boolean
  packageTolerance  Float
  replaceable       Boolean
  list              ShoppingList @relation(fields: [listId], references: [id])
}

model UserPreferenceProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  maxDistanceKm    Int      @default(15)
  allowSplitStore  Boolean  @default(false)
  preferredKosher  String[]
  preferredBrands  String[]
  excludedStores   String[]
  notes            String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id])
}

model IngestionRun {
  id           String   @id
  source       String
  startedAt    DateTime
  finishedAt   DateTime?
  status       String
  fetchedItems Int
  ingestedRows Int
  errorMessage String?
  sourceDetails Json?
  correlationId String?
  idempotencyKey String?
  createdAt    DateTime @default(now())
}

model JobExecution {
  id            String   @id
  jobName        String
  idempotencyKey String   @unique
  status         String
  attempts       Int      @default(1)
  lastError      String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model RetailSource {
  id         String   @id @default(cuid())
  sourceKey  String   @unique
  nameHe     String
  nameEn     String?
  storeId    String
  feedUrl    String
  authHint   String?
  linkHash   String
  isActive   Boolean  @default(true)
  discoveredFrom String
  lastSeenAt DateTime
  syncCadenceMinutes Int @default(180)
  lastCatalogSyncAt DateTime?
  lastCatalogStatus String?
  lastCatalogError String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RetailOffer {
  id             String   @id @default(cuid())
  sourceKey      String
  storeId        String
  productName    String
  normalizedName String
  category       String?
  brand          String?
  barcode        String?
  imageUrl       String?
  priceAgorot    Int
  fetchedAt      DateTime @default(now())

  @@index([normalizedName])
  @@index([storeId, normalizedName])
  @@index([sourceKey, fetchedAt])
}
